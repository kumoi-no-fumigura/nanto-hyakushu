 "poems": [
  {
   "seq": "1",
   "text": "あすか河なかれてはやき年波もけふを春とや立かはるらん",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ねのひするまゆみの岡の姫小松ひくやまとゐのはしめ成蘭",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "杉たてる門をや春もたつねけん三輪の山邊のけさはかすめる",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春といへは出るひかりにさそはれてあしたの原に來鳴鶯",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "とのへもり誰跡つけて出つらんみかきか原の雪のむら消",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "泊瀨川はやくみしよの古里にむかしわすれぬ梅かゝそする",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "玉柳六田のよとに糸はへてわかあゆつるとみゆる春哉",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うちけふる若草山の下わらひ木のめも春と今やもゆらん",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "昨日けふ峯にも尾にもしら雲のたつたの櫻今さかりかも",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "こけむしろしく〓〓ふれる春雨は靑根か峯そ色まさりける",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "小篠原なつみし駒もひきかへつ日のくま川の春のけしきに",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "霞しく雪けの澤をたつ鴈のまた古〓はさえかへるらん",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "なけやなけさほの山邊のよふこ鳥はゝそも春にひこはへに鳬",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "いくしたて引やみしめの苗代にふるのわさ田も春や知らん",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "夜さむそふ秋ははつせの山風になをもつれなき松虫の聲",
   "kana": "",
   "speaker": "南都百首春",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "里人のうつや衣もたゆむらん十市の山に月かたふきぬ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あひにあひて露の光も玉きはる内の大野の月そさやけき",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "春日野のおとろの道はわけすとも鹿毛なる駒もけふやひく覽",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "あさかほの花にも霧の晴まよりみそめのさきの佛そたつ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "宮のたき霧のとはりのひまみえておつる白玉はもる人もなし",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "物おもふ袖にもさそなしけ岡の草葉にあまる秋の夕露",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さをしかの妻とふ聲も高圓の尾上のまはき今さかりかも",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "飛鳥のはかひの山の山かせもはらふか峯の遠のしら雲",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "秋風をならしの岡にならしてもそよとおとろく荻の音哉",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "藤はかま春のゆかりの花の名におほ川のへを秋そ句はす",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "風かよふあきつの小野のかるかやの亂れて物はわれそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かりねする手枕の野のしの薄くるれは露や先結ふらん",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "明るとやともしするおのわかるらんくらはし山によこ雲の空",
   "kana": "",
   "speaker": "南都百首秋",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "すか原や伏見のさなへほの〓〓と明る田面にそよくをそまつ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "年をへて五月のけふはをたえせぬ玉ゐの沼にあやめひく也",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "聞つともいはせの杜の郭公人傳ならぬ一聲もかな",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "神山のあふひはよその契りにて夜〓〓かけし葛城のはし",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "咲にけり神のみむろの榊葉にしらゆふかくる岸の卯花",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "立かへぬ雲の衣は春なからつなきて見ゆる天のかく山",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "けふとのみ春に手向の山さくらむへこそ花はぬさと散けれ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "ぬししらぬ花染衣春くれて口なし山にさけるやまふき",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "藤なみのかゝる末葉もめくみけり南のきしにたてし誓は",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "猿澤の池の玉もやへたつらんそこにはさかぬ杜若かな",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "一夜ねし露たに袖はしほれしを雪けの岡につむ菫哉",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "きよすみの池のかゝみの恨あれやつかはぬ鳥の浪のうきねは",
   "kana": "",
   "speaker": "南都百首夏",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "きのふけふ猶さえまさる飛鳥風七瀨のよとや氷はてなん",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "月影の〓き川原に小夜更て千鳥友よふさほの浦かな",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "冬の夜はたく火にせむとしめし野に澤へのあしも霜枯にけり",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "玉くしけ三室の山の明るよにかゝみをかけてふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "神なひのあさ篠はらに降霰ひろはぬ玉や世に殘るらん",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "白妙の雲間の虹は中絕て霜をきわたす久米の岩橋",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "まてふはしさのゝわたりの夕時雨やとゝふ三輪の里になる迄",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "かしは木の杜はくち葉に埋もれて道こそなけれ冬は來にけり",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "はつせめか賤はた帶の長月もくるれはけふに老めくりつゝ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "時雨ふる三輪の檜原をかきわけて秋や紅葉のかさし成らん",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "みゝなしの池のそかひに咲にけりなにをか音に菊のしら露",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "繪にかけるかたちのをのゝ女郞花心うこかす秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "花すりの衣は露にみたるともなをわけゆかむまのゝ萩原",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "七夕の手向にさらすけふはかりなに山姬の名をやからまし",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "三笠山きりの一葉もおちそめて天のしたには秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "夏はつる御秡やうけし神なひの杜の秋風ゆふかけて吹",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "春日山日かけはもらて氷室もるしけみか下そ夏の外なる",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "秋はけふまた夏なから辰の市やうるまの〓水むすふ袂に",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "たをやめの花のすかたの池水に舟を浮へてとるはちす哉",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "拂ひえぬうちはの里のかはしらに煙たてそふよるのあくたひ",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "山陰はまたよや殘る夏簑河かはと明てもとふ螢かな",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いにしへをみきのつかさの袖の香や奈良の都にのこる立花",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "五月雨は水分山の名もしるく雲におちそふ瀧のしら浪",
   "kana": "",
   "speaker": "",
   "page": 482,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "瀨を早みよし野の川の網代木にしらゆふ花の咲かぬまそなき",
   "kana": "",
   "speaker": "南都百首戀",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "庭火たきうたふあなしの山かつら曉かけて神あそひせん",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "かたの野のみゆき跡ある君か代に逢や嬉しきやかたをの鷹",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "雲よりもたかまの山に立煙よそにもしるし峯のすみかま",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "消ぬるか春より冬になら山のくろ木のこやの夜半の埋火",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "まきなかす丹生の河瀨の筏師のさこそは年の暮いそくらむ",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "けふよりは袖ふる山のみつ垣も知らぬためしに人をこひはや",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "もらすなよ夕ゐる雲の下比山谷にしつめる鳥の一聲",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "日にそへて思ひます田のいけるよの爲にねぬなはさそな苦しき",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "流れての浮名おもへはみなれ河みなれそめしそ今はくやしき",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "こりすまに又はまつちの山なりとにこりやせまし東雲の月",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "二本のすきにしかたそしのはるゝふる河のへに思ふ心は",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "旅れする枕のたちのつは市にかへてうき身の逢夜しらせよ",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "かるもかく猪かひの岡の草なれや起ふす床の露のみたれは",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "うしつらし二上山の峯の雲こなたはかりになと時雨らん",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "とはゝこそいはせの山の秋風にしたはふくすの露こほるとも",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "月やとるとよらの寺のえのは井に結ひもあへぬ曉の袖",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "名におひて高木の山の松なれや空のみとりに枝をかはせる",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "うつり行鶯山の春風は伏見の竹やまつなひくらん",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "みよし野の奥の岩ねにすむとてもこけの雫に袖はぬれなん",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "幾年をふる野の澤になれぬらん今もおりゐる鶴の毛衣",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "雲とのみ御舟の山の花ならはつねにあらなん春はすくとも",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "昔みしきさの小河はかはられと我とし波そ立かされぬる",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "葛城やたかまの草にあらすともしめさす野へは後もきてみん",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "よしの山花の關守櫻とは人をそとむる春はとまらす",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "さほ川に橋うちわたし我家のむかしの跡をみるそ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "立田山あらしをさむみ大伴のみつのとまりに舟そ休らふ",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "大和路やすみた河原に宿からむ遠く聞けるほとにはあらねと",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "よしさらはかたみとをなれあかすしてわかるゝ袖の岡越の道",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "まきもくの檜はらくもりて峯深き月にはうとき山の下庵",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "吹風にひかぬ鳴子をひくて山麓のひつちもる人もなし",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "かきつめし大和〓とのはちり〓〓にならの里人名のみふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 483,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "曉のかねのみたけにやとからんこむよをかけて夢やさめぬと",
   "kana": "",
   "speaker": "",
